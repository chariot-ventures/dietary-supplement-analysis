{
  "openapi": "3.1.0",
  "info": {
    "title": "Dietary Supplement Label and Nutrient Intake Analysis",
    "version": "0.1.0",
    "description": "Look up dietary supplement labels from the NIH Dietary Supplement Label Database (DSLD) and total vitamin and mineral intake across a list of supplements, compared with NIH recommended amounts (RDA/AI) and upper limits (UL). Label and reference data only; not medical advice."
  },
  "externalDocs": {
    "url": "https://github.com/micallb/dietary-supplement-analysis#readme"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Service identity",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "summary": "Identity probe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "const": "dietary-supplement-analysis"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "service",
                    "version"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/search": {
      "post": {
        "summary": "Search DSLD products",
        "description": "Searches the NIH DSLD and returns up to `limit` (max 10) product summaries. On-market only by default.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "description": "Free-text search, e.g. \"vitamin d3 5000\"",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "brand": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "ingredient": {
                    "description": "Ingredient name, e.g. \"cholecalciferol\"",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "on_market_only": {
                    "default": true,
                    "type": "boolean"
                  },
                  "limit": {
                    "default": 5,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string",
                      "const": "dietary-supplement-analysis"
                    },
                    "version": {
                      "type": "string"
                    },
                    "as_of": {
                      "type": "string",
                      "format": "date"
                    },
                    "query": {
                      "type": "object"
                    },
                    "total_hits": {
                      "type": "integer"
                    },
                    "returned": {
                      "type": "integer"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProductSummary"
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Source"
                      }
                    },
                    "disclaimer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (unknown DSLD ID or nutrient)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "UNSUPPORTED (e.g. pregnancy, infants)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "424": {
            "description": "UPSTREAM_UNAVAILABLE: NIH DSLD unreachable and nothing cached (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/get": {
      "post": {
        "summary": "Get normalized labels",
        "description": "Normalized label(s) by DSLD ID (max 10). Original label amounts are kept next to converted amounts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dsld_id": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 10000000,
                    "description": "DSLD label ID, e.g. from /v1/products/search"
                  },
                  "dsld_ids": {
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 10000000,
                      "description": "DSLD label ID, e.g. from /v1/products/search"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Labels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string",
                      "const": "dietary-supplement-analysis"
                    },
                    "version": {
                      "type": "string"
                    },
                    "as_of": {
                      "type": "string",
                      "format": "date"
                    },
                    "requested": {
                      "type": "integer"
                    },
                    "returned": {
                      "type": "integer"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Label"
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Source"
                      }
                    },
                    "disclaimer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (unknown DSLD ID or nutrient)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "UNSUPPORTED (e.g. pregnancy, infants)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "424": {
            "description": "UPSTREAM_UNAVAILABLE: NIH DSLD unreachable and nothing cached (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/nutrients/reference": {
      "post": {
        "summary": "Reference intakes for a nutrient",
        "description": "RDA, EAR, AI and UL for one nutrient at an age and sex. Offline and deterministic.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nutrient": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Nutrient ID (\"vitamin-d\") or any synonym (\"cholecalciferol\")"
                  },
                  "age": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 120,
                    "description": "Age in years. Ages under 1 are not supported in v1."
                  },
                  "sex": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female"
                    ]
                  }
                },
                "required": [
                  "nutrient",
                  "age",
                  "sex"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reference values",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string",
                      "const": "dietary-supplement-analysis"
                    },
                    "version": {
                      "type": "string"
                    },
                    "as_of": {
                      "type": "string",
                      "format": "date"
                    },
                    "nutrient": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "unit": {
                          "type": "string"
                        }
                      }
                    },
                    "profile": {
                      "type": "object",
                      "properties": {
                        "age": {
                          "type": "number"
                        },
                        "sex": {
                          "type": "string"
                        }
                      }
                    },
                    "reference": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "has_dri": {
                      "type": "boolean"
                    },
                    "factsheet_url": {
                      "type": "string"
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Source"
                      }
                    },
                    "disclaimer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (unknown DSLD ID or nutrient)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "UNSUPPORTED (e.g. pregnancy, infants)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "424": {
            "description": "UPSTREAM_UNAVAILABLE: NIH DSLD unreachable and nothing cached (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stack/analyze": {
      "post": {
        "summary": "Analyze a supplement stack",
        "description": "Per-nutrient daily totals across 1-15 products (DSLD IDs or custom ingredient lists), compared with reference intakes when age and sex are given. No flag means nothing to report, not a judgement about the stack.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "age": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 120,
                    "description": "Age in years. Ages under 1 are not supported in v1."
                  },
                  "sex": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female"
                    ]
                  },
                  "products": {
                    "minItems": 1,
                    "maxItems": 15,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "dsld_id": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 10000000,
                              "description": "DSLD label ID, e.g. from /v1/products/search"
                            },
                            "servings_per_day": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 50,
                              "description": "Servings taken per day. Default: the label maximum daily servings, else 1."
                            }
                          },
                          "required": [
                            "dsld_id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "servings_per_day": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 50,
                              "description": "Servings taken per day. Default: the label maximum daily servings, else 1."
                            },
                            "ingredients": {
                              "minItems": 1,
                              "maxItems": 50,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 200
                                  },
                                  "amount": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 10000000
                                  },
                                  "unit": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 30,
                                    "description": "mg, mcg, g, IU, mcg DFE, mcg RAE, mg NE"
                                  },
                                  "form": {
                                    "description": "Declared form, e.g. \"folic acid\", \"retinyl palmitate\", \"d-alpha tocopherol\"",
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 200
                                  },
                                  "nutrient_basis": {
                                    "description": "For minerals: whether amount is elemental or the whole compound weight",
                                    "type": "string",
                                    "enum": [
                                      "elemental",
                                      "compound"
                                    ]
                                  }
                                },
                                "required": [
                                  "name",
                                  "amount",
                                  "unit"
                                ]
                              }
                            }
                          },
                          "required": [
                            "ingredients"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "description": "1-15 products: each a DSLD ID or a custom product with explicit ingredients"
                  }
                },
                "required": [
                  "products"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stack analysis",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string",
                      "const": "dietary-supplement-analysis"
                    },
                    "version": {
                      "type": "string"
                    },
                    "as_of": {
                      "type": "string",
                      "format": "date"
                    },
                    "profile": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "age": {
                              "type": "number"
                            },
                            "sex": {
                              "type": "string"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "products_matched": {
                          "type": "integer"
                        },
                        "nutrients_totaled": {
                          "type": "integer"
                        },
                        "above_ul": {
                          "type": "integer"
                        },
                        "below_reference": {
                          "type": "integer"
                        },
                        "data_gaps": {
                          "type": "integer"
                        }
                      }
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "nutrient_totals": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/NutrientTotal"
                      }
                    },
                    "overlaps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nutrient_id": {
                            "type": "string"
                          },
                          "product_refs": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    "unrecognized_ingredients": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/UnrecognizedIngredient"
                      }
                    },
                    "data_gaps": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DataGap"
                      }
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_ref": {
                            "type": "string"
                          },
                          "dsld_id": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "brand": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "name": {
                            "type": "string"
                          },
                          "servings_per_day_used": {
                            "type": "number"
                          },
                          "servings_source": {
                            "type": "string",
                            "enum": [
                              "request",
                              "label_maximum",
                              "default"
                            ]
                          },
                          "source_url": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Source"
                      }
                    },
                    "disclaimer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (unknown DSLD ID or nutrient)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "UNSUPPORTED (e.g. pregnancy, infants)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "424": {
            "description": "UPSTREAM_UNAVAILABLE: NIH DSLD unreachable and nothing cached (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tool": {
      "post": {
        "summary": "Tool dispatcher",
        "description": "MCP-style call: {\"tool\": \"stack_analyze\", \"arguments\": {...}}. Returns the same body as the matching route.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string",
                    "enum": [
                      "products_search",
                      "products_get",
                      "nutrients_reference",
                      "stack_analyze"
                    ]
                  },
                  "arguments": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "tool"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result of the dispatched tool",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (unknown DSLD ID or nutrient)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "UNSUPPORTED (e.g. pregnancy, infants)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "424": {
            "description": "UPSTREAM_UNAVAILABLE: NIH DSLD unreachable and nothing cached (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Source": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "retrieved": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "url",
          "retrieved"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_INPUT",
                  "NOT_FOUND",
                  "UNSUPPORTED",
                  "UPSTREAM_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "field": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "DataGap": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BLEND_UNQUANTIFIED",
              "QUANTITY_MISSING",
              "UNIT_NOT_CONVERTIBLE",
              "COMPOUND_WEIGHT",
              "AMBIGUOUS_BASIS",
              "UL_PARTIAL",
              "UL_NOT_ASSESSED",
              "NO_REFERENCE",
              "PROFILE_MISSING",
              "SERVINGS_UNKNOWN",
              "INTERACTIONS_NOT_ASSESSED"
            ]
          },
          "product_ref": {
            "type": "string"
          },
          "nutrient_id": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ]
      },
      "Serving": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "daily_servings": {
            "type": "object",
            "properties": {
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "label_text": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Ingredient": {
        "type": "object",
        "properties": {
          "label_name": {
            "type": "string"
          },
          "nutrient_id": {
            "type": "string"
          },
          "nutrient_name": {
            "type": "string"
          },
          "matched_by": {
